    "@react-three/fiber": "^8.17.0",
    "d3-force-3d": "^3.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@synapse/core": "*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
