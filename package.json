{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test packages/core/dist/test/",
    "analyze": "node packages/cli/dist/index.js analyze",
    "build:web": "npm run build --workspace @synapse/web",
    "build:all": "npm run build && npm run build:web",
    "dev:web": "npm run dev --workspace @synapse/web"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
